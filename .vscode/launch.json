{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) 启动", // 配置名称改为表示使用gdb
            "type": "cppdbg",      // 调试器类型改为 cppdbg（使用GDB）
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe", // 自动构建可执行文件路径
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": true,  // 改为 false，使用内置终端
            "MIMode": "gdb",         // 指定调试器为gdb
            "miDebuggerPath": "D:\\apps\\mingw-builds\\benti\\mingw64\\bin\\gdb.exe", // GDB路径
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe 生成活动文件" // 在启动调试前先执行编译任务
        }
    ]
}